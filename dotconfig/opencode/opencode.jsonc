{
  "plugins": [
    // "@kitlangton/opencode-session-recap",
    "/Users/m/repos/opencode-effect-enforcer/src",
    {
      "package": "/Users/m/repos/EeveE/packages/opencode/src/index.ts",
      "options": {
        "agentsDirectory": "/Users/m/repos/.opencode/agents",
      },
    },
    {
      "package": "/Users/m/repos/opencode-imagen/dist",
      "options": {},
    },
    "@plannotator/opencode@latest",
  ],
  "mcp": {
    "servers": {
      "github": {
        "type": "local",
        "command": [
          "/bin/sh",
          "-c",
          "export GITHUB_PERSONAL_ACCESS_TOKEN=\"$(/opt/homebrew/bin/gh auth token)\"; exec /opt/homebrew/bin/github-mcp-server stdio --tools search_repositories --read-only",
        ],
      },
      "linear": {
        "type": "remote",
        "url": "https://mcp.linear.app/mcp",
      },
      "marco-polo": {
        "type": "remote",
        "url": "https://executor.sh/marco-polo/mcp",
      },
      "notion": {
        "type": "remote",
        "url": "https://mcp.notion.com/mcp"
      },
    },
  },
  "permissions": [
    { "action": "*", "resource": "*", "effect": "allow" },
  ],
  "references": {
    "effect": {
      "repository": "Effect-TS/effect",
      "branch": "main",
      "description": "Effect v4 full source code",
    },
    "foldkit": {
      "repository": "foldkit/foldkit",
      "branch": "main",
      "description": "Foldkit full source code",
    },
    "alchemy": {
      "repository": "alchemy-run/alchemy-effect",
      "branch": "main",
      "description": "Alchemy full source code",
    },
    "foldkit-docs": {
      "repository": "mpsuesser/scraped-docs-foldkit",
      "branch": "main",
      "description": "Full scraped documentation for Foldkit",
    },
    "alchemy-docs": {
      "repository": "mpsuesser/scraped-docs-alchemy",
      "branch": "main",
      "description": "Full scraped documentation for Alchemy",
    },
    "CurationSpace": {
      "path": "/Users/m/repos/CurationSpace",
    },
    "MyDB": {
      "path": "/Users/m/repos/mydb",
    },
    "effect-oxlint": {
      "path": "/Users/m/repos/effect-oxlint",
    },
    "oxlint-plugin-effect": {
      "path": "/Users/m/repos/oxlint-plugin-effect",
    },
    "editor": {
      "path": "/Users/m/repos/editor",
    },
    "workspace": {
      "path": "/Users/m/repos/workspace",
    },
    "opencode-dotconfig": {
      "path": "/Users/m/repos/workspace/dotconfig/opencode",
    },
    "helix-dotconfig": {
      "path": "/Users/m/repos/workspace/dotconfig/helix/",
    },
    "helix": {
      "repository": "helix-editor/helix",
      "branch": "master",
    },
    "opencode": {
      "repository": "anomalyco/opencode",
      "branch": "dev",
    },
    "opentui": {
      "repository": "anomalyco/opentui",
      "branch": "main",
    },
    "interview-me-yap-studio": {
      "path": "/Users/m/repos/interview-me",
    },
    "mpsuesser": {
      "path": "/Users/m/repos/mpsuesser",
    },
    "WriteLikeMe": {
      "path": "/Users/m/repos/WriteLikeMe",
    },
    "MarcSuesser.com": {
      "path": "/Users/m/repos/marcsuesser.com",
    },
    "Dojo": {
      "path": "/Users/m/repos/dojo",
    },
    "FaradayExchange": {
      "path": "/Users/m/repos/FaradayExchange",
    }
  },
  "agents": {
    "build": {
      "permissions": [
        { "action": "subagent", "resource": "*", "effect": "deny" },
        { "action": "subagent", "resource": "explore", "effect": "allow" },
        { "action": "subagent", "resource": "general", "effect": "allow" },
      ],
    },
    "plan": {
      "permissions": [
        { "action": "subagent", "resource": "*", "effect": "deny" },
        { "action": "subagent", "resource": "explore", "effect": "allow" },
        { "action": "subagent", "resource": "general", "effect": "allow" },
      ],
    },
    "explore": {
      "permissions": [
        { "action": "subagent", "resource": "*", "effect": "deny" },
      ],
    },
    "general": {
      "permissions": [
        { "action": "subagent", "resource": "*", "effect": "deny" },
      ],
    },
  },
  "experimental": {
    "disable_paste_summary": true,
  },
  "websearch": {
    "provider": "random"
  },
}
