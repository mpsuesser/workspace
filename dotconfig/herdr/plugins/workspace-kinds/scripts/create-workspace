#!/bin/sh

set -eu

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
. "$script_dir/config"

herdr_bin=${HERDR_BIN_PATH:-herdr}
editor=${EDITOR:-vi}

read_title() {
	gum input \
		--header "$1" \
		--placeholder "$2" \
		--char-limit 72 \
		--width 60
}

choose() {
	tv \
		--no-preview \
		--no-remote \
		--no-status-bar \
		--input-header "$1"
}

normalize_title() {
	printf '%s' "$1" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//'
}

require_title() {
	title=$1
	case "$title" in
		"" | . | ..)
			gum style --foreground 196 'A title is required.' >&2
			exit 1
			;;
		*/*)
			gum style --foreground 196 'Titles cannot contain path separators.' >&2
			exit 1
			;;
	esac
}

shell_quote() {
	printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"
}

choose_post() {
	{
		printf '%s\n' 'Create new post...'
		for path in "$POSTS_DIR"/*.md; do
			[ -e "$path" ] || continue
			filename=${path##*/}
			printf '%s\n' "${filename%.md}"
		done
	} | choose 'Choose a post'
}

kind=$(printf '%s\n' Agent Post Skill Project None | choose 'Workspace kind')
[ -n "$kind" ] || exit 0

case "$kind" in
	Post)
		selection=$(choose_post)
		[ -n "$selection" ] || exit 0
		if [ "$selection" = 'Create new post...' ]; then
			title=$(normalize_title "$(read_title 'New post' 'Post title')")
			title=${title%.md}
			require_title "$title"
			post_path="$POSTS_DIR/$title.md"
			if [ ! -e "$post_path" ]; then
				(set -C; printf '# %s\n' "$title" >"$post_path") || {
					gum style --foreground 196 "Could not create $post_path" >&2
					exit 1
				}
			fi
		else
			title=$selection
			post_path="$POSTS_DIR/$title.md"
		fi
		workspace_label="Post: $title"
		workspace_cwd=$POST_WORKSPACE_DIR
		;;
	Agent | Skill | Project)
		title=$(normalize_title "$(read_title "New $kind workspace" 'Workspace title')")
		require_title "$title"
		workspace_label="$kind: $title"
		workspace_cwd=$HOME
		;;
	None)
		title=$(normalize_title "$(read_title 'New workspace' 'Workspace title')")
		require_title "$title"
		workspace_label=$title
		workspace_cwd=$HOME
		;;
esac

response=$("$herdr_bin" workspace create \
	--cwd "$workspace_cwd" \
	--label "$workspace_label" \
	--focus)

if [ "$kind" = Post ]; then
	root_pane_id=$(printf '%s\n' "$response" | jq -r '.result.root_pane.pane_id')
	quoted_post_path=$(shell_quote "$post_path")
	"$herdr_bin" pane run "$root_pane_id" "exec $editor $quoted_post_path" >/dev/null
fi
